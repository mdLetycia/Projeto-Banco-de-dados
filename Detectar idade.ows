		<properties node_id="7" format="literal">{'C': 1.0, 'auto_apply': True, 'coef0': 1.0, 'controlAreaVisible': True, 'degree': 3, 'epsilon': 0.1, 'gamma': 0.0, 'kernel_type': 2, 'learner_name': '', 'limit_iter': True, 'max_iter': 100, 'nu': 0.5, 'nu_C': 1.0, 'savedWidgetGeometry': None, 'svm_type': 0, 'tol': 0.001, '__version__': 2}</properties>
		<properties node_id="8" format="literal">{'activation_index': 3, 'alpha_index': 1, 'auto_apply': True, 'controlAreaVisible': True, 'hidden_layers_input': '100,', 'learner_name': '', 'max_iterations': 200, 'replicable': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03(\x00\x00\x01V\x00\x00\x04X\x00\x00\x02\x93\x00\x00\x03)\x00\x00\x01u\x00\x00\x04W\x00\x00\x02\x92\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03)\x00\x00\x01u\x00\x00\x04W\x00\x00\x02\x92', 'solver_index': 2, '__version__': 2}</properties>
		<properties node_id="9" format="literal">{'auto_save': True, 'controlAreaVisible': True, 'filter': 'Pickled model (*.pkcls)', 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03M\x00\x00\x01\xb5\x00\x00\x04\x83\x00\x00\x025\x00\x00\x03N\x00\x00\x01\xd4\x00\x00\x04\x82\x00\x00\x024\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03N\x00\x00\x01\xd4\x00\x00\x04\x82\x00\x00\x024', 'stored_name': 'Modelo_detectar idade.pkcls', 'stored_path': '.', '__version__': 1}</properties>
		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x08\x00\x00\x020\x00\x00\x00\xd8\x00\x00\x05P\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import os\nimport numpy as np\nimport cv2\n\nfrom Orange.data import Table, Domain, ContinuousVariable\n\n# --- AJUSTE ESTES DOIS CAMINHOS -----------------------------------------\nWORKSPACE_PATH   = "C:\\\\Users\\\\Aluno\\\\Downloads\\\\VOULEMBRAR\\\\Aula03\\\\Aula03"\nYUNET_MODEL_PATH = f"{WORKSPACE_PATH}\\\\face_detection_yunet_2023mar.onnx"\nSFACE_MODEL_PATH = f"{WORKSPACE_PATH}\\\\face_recognition_sface_2021dec.onnx"\n# -------------------------------------------------------------------------\n\nN_FEATURES = 128  # dimensão do embedding gerado pelo SFace\n\n# Identificador gravado em cada atributo gerado (var.attributes["embedder"]).\n# É essa tag que permite ao backend Flask identificar automaticamente,\n# só olhando o modelo (.pkcls), qual pipeline de embedding usar antes de\n# classificar uma imagem nova. Mantenha este valor sincronizado com\n# FACE_EMBEDDER_ID em classifier/embedder.py no projeto Flask.\nEMBEDDER_ID = "opencv_sface_v1"\n\nYUNET_INPUT_SIZE = (320, 320)   # tamanho usado internamente pelo detector\n\n# Datasets de rostos gerados/sintéticos costumam ter imagens já recortadas\n# bem justas no rosto (pouca margem) e pequenos artefatos de geração, o\n# que derruba a confiança do YuNet. Um threshold menor tolera isso melhor.\nYUNET_SCORE_THRESHOLD = 0.6\nYUNET_NMS_THRESHOLD = 0.3\nYUNET_TOP_K = 5000\n\n# Tamanho de entrada esperado pelo SFace para uma face já alinhada/recortada.\nSFACE_INPUT_SIZE = (112, 112)\n\n# Se True: quando o YuNet não detectar nenhum rosto (mesmo com padding),\n# assume que a imagem inteira já É o rosto (comum em datasets sintéticos\n# já pré-recortados) e gera o embedding direto da imagem, sem alinhamento.\nFALLBACK_FULL_IMAGE_AS_FACE = True\n\n# Proporção de borda adicionada na 2ª tentativa de detecção (dá "contexto"\n# extra ao redor de rostos que preenchem quase todo o quadro).\nPADDING_RATIO = 0.25\n\n\ndef _check_models_exist():\n    for path, label in (\n        (YUNET_MODEL_PATH, "YuNet"),\n        (SFACE_MODEL_PATH, "SFace"),\n    ):\n        if not os.path.isfile(path):\n            raise FileNotFoundError(\n                f"Modelo {label} não encontrado em \'{path}\'. Baixe o "\n                f"arquivo .onnx (veja instruções no topo do script) e "\n                f"ajuste o caminho correspondente."\n            )\n\n\ndef _create_detector_and_recognizer():\n    _check_models_exist()\n\n    detector = cv2.FaceDetectorYN.create(\n        YUNET_MODEL_PATH,\n        "",\n        YUNET_INPUT_SIZE,\n        YUNET_SCORE_THRESHOLD,\n        YUNET_NMS_THRESHOLD,\n        YUNET_TOP_K,\n    )\n    recognizer = cv2.FaceRecognizerSF.create(SFACE_MODEL_PATH, "")\n    return detector, recognizer\n\n\ndef _find_image_path_attr(domain):\n    """Localiza a variável meta que contém o caminho da imagem."""\n    for attr in domain.metas:\n        if attr.attributes.get("type") == "image":\n            return attr\n    for attr in domain.metas:\n        if attr.is_string:\n            return attr\n    raise ValueError(\n        "Não foi encontrada nenhuma coluna meta com o caminho da imagem "\n        "em \'in_data\'. Verifique se a tabela de entrada veio do widget "\n        "\'Import Images\' (ou equivalente)."\n    )\n\n\ndef _detect_largest_face(img, detector):\n    """Roda o YuNet na imagem e retorna a linha de detecção do maior rosto, ou None."""\n    h, w = img.shape[:2]\n    detector.setInputSize((w, h))\n    _, faces = detector.detect(img)\n\n    if faces is None or len(faces) == 0:\n        return None\n\n    if len(faces) &gt; 1:\n        # Mantém apenas o maior rosto (maior área do bounding box: w * h).\n        faces = faces[np.argsort(faces[:, 2] * faces[:, 3])[::-1]]\n\n    return faces[0]\n\n\ndef _extract_feature_vector(image_path, detector, recognizer):\n    """\n    Retorna um vetor numpy de 128 posições com o embedding do maior rosto\n    encontrado na imagem, ou None se nenhum rosto puder ser processado.\n\n    Estratégia em 3 tentativas (a 2ª e a 3ª existem especialmente para\n    lidar com datasets de rostos gerados/sintéticos, já pré-recortados):\n      1. Detecção normal na imagem original.\n      2. Detecção na imagem com uma borda extra (padding), que dá mais\n         "contexto" ao YuNet quando o rosto já preenche quase todo o quadro.\n      3. Fallback: assume que a imagem inteira já é o rosto (sem detecção/\n         alinhamento) e gera o embedding direto — útil quando o dataset é\n         formado só por recortes de rosto bem centralizados.\n    """\n    img = cv2.imread(f"{WORKSPACE_PATH}/dataset_age_groups/train/{image_path}")\n    if img is None:\n        print(f"[face_features] Falha ao abrir \'{image_path}\'.")\n        return None\n\n    # --- Tentativa 1: detecção normal -----------------------------------\n    face = _detect_largest_face(img, detector)\n    source_img = img\n\n    # --- Tentativa 2: detecção com padding -------------------------------\n    if face is None:\n        h, w = img.shape[:2]\n        pad_h, pad_w = int(h * PADDING_RATIO), int(w * PADDING_RATIO)\n        padded = cv2.copyMakeBorder(\n            img, pad_h, pad_h, pad_w, pad_w, cv2.BORDER_REFLECT101\n        )\n        face = _detect_largest_face(padded, detector)\n        if face is not None:\n            source_img = padded\n            print(f"[face_features] Rosto encontrado apenas com padding em: {image_path}")\n\n    if face is not None:\n        try:\n            aligned = recognizer.alignCrop(source_img, face)\n            feature = recognizer.feature(aligned)\n            return np.asarray(feature, dtype=float).flatten()\n        except Exception as exc:\n            print(f"[face_features] Falha ao gerar embedding para \'{image_path}\': {exc}")\n            return None\n\n    # --- Tentativa 3: fallback (imagem inteira como rosto) --------------\n    if not FALLBACK_FULL_IMAGE_AS_FACE:\n        print(f"[face_features] Nenhum rosto detectado em: {image_path}")\n        return None\n\n    print(\n        f"[face_features] YuNet não detectou rosto em \'{image_path}\'; "\n        f"usando a imagem inteira como fallback (comum em datasets já "\n        f"pré-recortados no rosto)."\n    )\n    try:\n        resized = cv2.resize(img, SFACE_INPUT_SIZE, interpolation=cv2.INTER_LINEAR)\n        feature = recognizer.feature(resized)\n        return np.asarray(feature, dtype=float).flatten()\n    except Exception as exc:\n        print(f"[face_features] Fallback também falhou para \'{image_path}\': {exc}")\n        return None\n\n\ndef extract_features(data: Table) -&gt; Table:\n    """Gera a Table de saída com os vetores de características faciais."""\n    path_attr = _find_image_path_attr(data.domain)\n    detector, recognizer = _create_detector_and_recognizer()\n\n    feature_vars = []\n    for i in range(N_FEATURES):\n        var = ContinuousVariable(f"face_feature_{i}")\n        # Tag persistida no domínio (sobrevive ao pickle do .pkcls) para\n        # que o backend identifique automaticamente o embedder correto.\n        var.attributes["embedder"] = EMBEDDER_ID\n        feature_vars.append(var)\n    new_domain = Domain(\n        feature_vars,\n        class_vars=data.domain.class_vars,\n        metas=data.domain.metas,\n    )\n\n    rows = []\n    skipped = 0\n\n    for inst in data:\n        image_path = str(inst[path_attr])\n        vector = _extract_feature_vector(image_path, detector, recognizer)\n\n        if vector is None:\n            skipped += 1\n            continue\n\n        row = (\n            list(vector)\n            + [inst[cv_] for cv_ in data.domain.class_vars]\n            + [inst[m] for m in data.domain.metas]\n        )\n        rows.append(row)\n\n    if not rows:\n        print("[face_features] Nenhuma imagem produziu um vetor válido.")\n        return Table.from_domain(new_domain, n_rows=0)\n\n    out = Table.from_list(new_domain, rows)\n\n    print(\n        f"[face_features] {len(rows)} imagem(ns) processada(s) com sucesso, "\n        f"{skipped} ignorada(s) por falta de rosto detectado."\n    )\n    return out\n\n\n# --- Ponto de entrada usado pelo widget "Python Script" -----------------\nif "in_data" in globals() and in_data is not None:\n    out_data = extract_features(in_data)\nelse:\n    out_data = None\n    print("[face_features] Nenhum dado de entrada conectado (in_data é None).")', 'filename': None}], 'scriptText': 'import os\nimport numpy as np\nimport cv2\n\nfrom Orange.data import Table, Domain, ContinuousVariable\n\n# --- AJUSTE ESTES DOIS CAMINHOS -----------------------------------------\nWORKSPACE_PATH   = "C:\\\\Users\\\\Aluno\\\\Downloads\\\\VOULEMBRAR\\\\Aula03\\\\Aula03"\nYUNET_MODEL_PATH = f"{WORKSPACE_PATH}\\\\face_detection_yunet_2023mar.onnx"\nSFACE_MODEL_PATH = f"{WORKSPACE_PATH}\\\\face_recognition_sface_2021dec.onnx"\n# -------------------------------------------------------------------------\n\nN_FEATURES = 128  # dimensão do embedding gerado pelo SFace\n\n# Identificador gravado em cada atributo gerado (var.attributes["embedder"]).\n# É essa tag que permite ao backend Flask identificar automaticamente,\n# só olhando o modelo (.pkcls), qual pipeline de embedding usar antes de\n# classificar uma imagem nova. Mantenha este valor sincronizado com\n# FACE_EMBEDDER_ID em classifier/embedder.py no projeto Flask.\nEMBEDDER_ID = "opencv_sface_v1"\n\nYUNET_INPUT_SIZE = (320, 320)   # tamanho usado internamente pelo detector\n\n# Datasets de rostos gerados/sintéticos costumam ter imagens já recortadas\n# bem justas no rosto (pouca margem) e pequenos artefatos de geração, o\n# que derruba a confiança do YuNet. Um threshold menor tolera isso melhor.\nYUNET_SCORE_THRESHOLD = 0.6\nYUNET_NMS_THRESHOLD = 0.3\nYUNET_TOP_K = 5000\n\n# Tamanho de entrada esperado pelo SFace para uma face já alinhada/recortada.\nSFACE_INPUT_SIZE = (112, 112)\n\n# Se True: quando o YuNet não detectar nenhum rosto (mesmo com padding),\n# assume que a imagem inteira já É o rosto (comum em datasets sintéticos\n# já pré-recortados) e gera o embedding direto da imagem, sem alinhamento.\nFALLBACK_FULL_IMAGE_AS_FACE = True\n\n# Proporção de borda adicionada na 2ª tentativa de detecção (dá "contexto"\n# extra ao redor de rostos que preenchem quase todo o quadro).\nPADDING_RATIO = 0.25\n\n\ndef _check_models_exist():\n    for path, label in (\n        (YUNET_MODEL_PATH, "YuNet"),\n        (SFACE_MODEL_PATH, "SFace"),\n    ):\n        if not os.path.isfile(path):\n            raise FileNotFoundError(\n                f"Modelo {label} não encontrado em \'{path}\'. Baixe o "\n                f"arquivo .onnx (veja instruções no topo do script) e "\n                f"ajuste o caminho correspondente."\n            )\n\n\ndef _create_detector_and_recognizer():\n    _check_models_exist()\n\n    detector = cv2.FaceDetectorYN.create(\n        YUNET_MODEL_PATH,\n        "",\n        YUNET_INPUT_SIZE,\n        YUNET_SCORE_THRESHOLD,\n        YUNET_NMS_THRESHOLD,\n        YUNET_TOP_K,\n    )\n    recognizer = cv2.FaceRecognizerSF.create(SFACE_MODEL_PATH, "")\n    return detector, recognizer\n\n\ndef _find_image_path_attr(domain):\n    """Localiza a variável meta que contém o caminho da imagem."""\n    for attr in domain.metas:\n        if attr.attributes.get("type") == "image":\n            return attr\n    for attr in domain.metas:\n        if attr.is_string:\n            return attr\n    raise ValueError(\n        "Não foi encontrada nenhuma coluna meta com o caminho da imagem "\n        "em \'in_data\'. Verifique se a tabela de entrada veio do widget "\n        "\'Import Images\' (ou equivalente)."\n    )\n\n\ndef _detect_largest_face(img, detector):\n    """Roda o YuNet na imagem e retorna a linha de detecção do maior rosto, ou None."""\n    h, w = img.shape[:2]\n    detector.setInputSize((w, h))\n    _, faces = detector.detect(img)\n\n    if faces is None or len(faces) == 0:\n        return None\n\n    if len(faces) &gt; 1:\n        # Mantém apenas o maior rosto (maior área do bounding box: w * h).\n        faces = faces[np.argsort(faces[:, 2] * faces[:, 3])[::-1]]\n\n    return faces[0]\n\n\ndef _extract_feature_vector(image_path, detector, recognizer):\n    """\n    Retorna um vetor numpy de 128 posições com o embedding do maior rosto\n    encontrado na imagem, ou None se nenhum rosto puder ser processado.\n\n    Estratégia em 3 tentativas (a 2ª e a 3ª existem especialmente para\n    lidar com datasets de rostos gerados/sintéticos, já pré-recortados):\n      1. Detecção normal na imagem original.\n      2. Detecção na imagem com uma borda extra (padding), que dá mais\n         "contexto" ao YuNet quando o rosto já preenche quase todo o quadro.\n      3. Fallback: assume que a imagem inteira já é o rosto (sem detecção/\n         alinhamento) e gera o embedding direto — útil quando o dataset é\n         formado só por recortes de rosto bem centralizados.\n    """\n    img = cv2.imread(f"{WORKSPACE_PATH}/dataset_age_groups/train/{image_path}")\n    if img is None:\n        print(f"[face_features] Falha ao abrir \'{image_path}\'.")\n        return None\n\n    # --- Tentativa 1: detecção normal -----------------------------------\n    face = _detect_largest_face(img, detector)\n    source_img = img\n\n    # --- Tentativa 2: detecção com padding -------------------------------\n    if face is None:\n        h, w = img.shape[:2]\n        pad_h, pad_w = int(h * PADDING_RATIO), int(w * PADDING_RATIO)\n        padded = cv2.copyMakeBorder(\n            img, pad_h, pad_h, pad_w, pad_w, cv2.BORDER_REFLECT101\n        )\n        face = _detect_largest_face(padded, detector)\n        if face is not None:\n            source_img = padded\n            print(f"[face_features] Rosto encontrado apenas com padding em: {image_path}")\n\n    if face is not None:\n        try:\n            aligned = recognizer.alignCrop(source_img, face)\n            feature = recognizer.feature(aligned)\n            return np.asarray(feature, dtype=float).flatten()\n        except Exception as exc:\n            print(f"[face_features] Falha ao gerar embedding para \'{image_path}\': {exc}")\n            return None\n\n    # --- Tentativa 3: fallback (imagem inteira como rosto) --------------\n    if not FALLBACK_FULL_IMAGE_AS_FACE:\n        print(f"[face_features] Nenhum rosto detectado em: {image_path}")\n        return None\n\n    print(\n        f"[face_features] YuNet não detectou rosto em \'{image_path}\'; "\n        f"usando a imagem inteira como fallback (comum em datasets já "\n        f"pré-recortados no rosto)."\n    )\n    try:\n        resized = cv2.resize(img, SFACE_INPUT_SIZE, interpolation=cv2.INTER_LINEAR)\n        feature = recognizer.feature(resized)\n        return np.asarray(feature, dtype=float).flatten()\n    except Exception as exc:\n        print(f"[face_features] Fallback também falhou para \'{image_path}\': {exc}")\n        return None\n\n\ndef extract_features(data: Table) -&gt; Table:\n    """Gera a Table de saída com os vetores de características faciais."""\n    path_attr = _find_image_path_attr(data.domain)\n    detector, recognizer = _create_detector_and_recognizer()\n\n    feature_vars = []\n    for i in range(N_FEATURES):\n        var = ContinuousVariable(f"face_feature_{i}")\n        # Tag persistida no domínio (sobrevive ao pickle do .pkcls) para\n        # que o backend identifique automaticamente o embedder correto.\n        var.attributes["embedder"] = EMBEDDER_ID\n        feature_vars.append(var)\n    new_domain = Domain(\n        feature_vars,\n        class_vars=data.domain.class_vars,\n        metas=data.domain.metas,\n    )\n\n    rows = []\n    skipped = 0\n\n    for inst in data:\n        image_path = str(inst[path_attr])\n        vector = _extract_feature_vector(image_path, detector, recognizer)\n\n        if vector is None:\n            skipped += 1\n            continue\n\n        row = (\n            list(vector)\n            + [inst[cv_] for cv_ in data.domain.class_vars]\n            + [inst[m] for m in data.domain.metas]\n        )\n        rows.append(row)\n\n    if not rows:\n        print("[face_features] Nenhuma imagem produziu um vetor válido.")\n        return Table.from_domain(new_domain, n_rows=0)\n\n    out = Table.from_list(new_domain, rows)\n\n    print(\n        f"[face_features] {len(rows)} imagem(ns) processada(s) com sucesso, "\n        f"{skipped} ignorada(s) por falta de rosto detectado."\n    )\n    return out\n\n\n# --- Ponto de entrada usado pelo widget "Python Script" -----------------\nif "in_data" in globals() and in_data is not None:\n    out_data = extract_features(in_data)\nelse:\n    out_data = None\n    print("[face_features] Nenhum dado de entrada conectado (in_data é None).")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="11" format="literal">{'comparison_criterion': 0, 'controlAreaVisible': True, 'cv_stratified': True, 'n_folds': 2, 'n_repeats': 3, 'resampling': 0, 'rope': 0.1, 'sample_size': 9, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x029\x00\x00\x00\xeb\x00\x00\x05F\x00\x00\x02\xfe\x00\x00\x02:\x00\x00\x01\n\x00\x00\x05E\x00\x00\x02\xfd\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x02:\x00\x00\x01\n\x00\x00\x05E\x00\x00\x02\xfd', 'shuffle_stratified': True, 'use_rope': False, 'score_table': {'show_score_hints': {'Model_': True, 'Train_': False, 'Test_': False, 'CA': True, 'PrecisionRecallFSupport': True, 'TargetScore': True, 'Precision': True, 'Recall': True, 'F1': True, 'AUC': True, 'LogLoss': False, 'Specificity': False, 'MatthewsCorrCoefficient': True, 'MSE': True, 'RMSE': True, 'MAE': True, 'MAPE': True, 'SMAPE': True, 'R2': True, 'CVRMSE': False, 'ClusteringScore': True, 'Silhouette': True, 'AdjustedMutualInfoScore': True}}, '__version__': 4, 'context_settings': []}</properties>
